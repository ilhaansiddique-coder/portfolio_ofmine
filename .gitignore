# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env*.local
.env

# typescript
*.tsbuildinfo

# local github response cache (re-seeded on next successful fetch)
/.gh-cache/

# Cloned source repos used to build the live theme demos. These are real git
# clones — committing them creates broken gitlinks that corrupt fresh clones.
/.demo-src/

# Build output of the demo engine (regenerated; must not be committed)
/demo-engine/out/
/demo-engine/.next/
/demo-engine/node_modules/

# The active theme is copied in per build by scripts/sync-theme.mjs.
/demo-engine/theme/

# The built storefront demos (~70MB). Regenerated by scripts/build-demos.mjs on
# every build, so they are deploy output, not source.
/public/demo/
