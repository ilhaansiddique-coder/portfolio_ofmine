{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next-dev/types/**/*.ts"],
  // demo-engine is a self-contained Next.js sub-project with its own tsconfig
  // and path aliases; home.tsx is a stray file from a storefront project.
  // Neither belongs to the portfolio — typechecking them from here fails on
  // their unresolved imports and breaks the build.
  "exclude": ["node_modules", "demo-engine", "home.tsx"]
}
